# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.cue text eol=lf
*.lrc text eol=lf
*.pro text eol=lf
*.gradle text eol=lf

# Gradle wrappers
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binary files
*.jar binary
*.so binary
*.aar binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.flac binary
*.ape binary
*.wv binary
*.dsf binary
*.dff binary
*.wav binary
*.mp3 binary
*.ogg binary
*.opus binary
*.wma binary
